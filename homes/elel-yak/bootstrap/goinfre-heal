#!/usr/bin/env bash
# Rebuild this machine's goinfre Nix setup when it is missing, wiped, or stale.
# $HOME roams between cluster machines; /goinfre is per-machine and gets wiped.
# Runs at every graphical login (goinfre-heal.service).
# Usage: goinfre-heal [--check | --force]   (`nix-up` runs --force)
set -uo pipefail
mode="${1:-}"
GOINFRE="${GOINFRE:-/goinfre/$USER}"
STAMP="${GOINFRE}/.setup-ok"
LOG="${GOINFRE}/setup.log"
host="$(hostname -s)"
here="$(dirname "$(readlink -f "$0")")"
# Fresh machine: measured 18.2 GiB Home Manager closure + 2.2 GiB apps + 0.6 GiB theme assets.
FRESH_NEED_MIB=$((25 * 1024))
# On top of what Nix reports: AppImages, theme copy, derivations built locally.
HEADROOM_MIB=$((3 * 1024))

# One notification slot: each status replaces the last instead of stacking.
# Never critical: GNOME 42 keeps critical banners until clicked, and a stale one
# can get stuck on screen until gnome-shell restarts.
NOTIFY_ID="${XDG_RUNTIME_DIR:-/tmp}/goinfre-heal.notify-id"
notify() { # <summary> <body>
  local out
  out="$(gdbus call --session --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    goinfre-heal "$(cat "$NOTIFY_ID" 2>/dev/null || echo 0)" "" "$1" "$2" \
    "[]" "{'urgency': <byte ${NOTIFY_URGENCY:-1}>}" 10000 2>/dev/null)" || return 0
  [[ "$out" =~ uint32\ ([0-9]+) ]] && echo "${BASH_REMATCH[1]}" >"$NOTIFY_ID"
}
gib() { awk -v m="$1" 'BEGIN { printf "%.1f GiB", m / 1024 }'; }
free_mib() { df -BM --output=avail /goinfre | tail -1 | tr -dc 0-9; }
have_nix() { [[ -x "${GOINFRE}/bin/nix-user-chroot" && -d "${GOINFRE}/nix/store" ]]; }

# A roaming symlink is usable only if its /nix/store target exists in this
# machine's store. Outside the chroot /nix is absent, so look on goinfre.
in_store() {
  local t
  t="$(readlink -m "$1" 2>/dev/null)" || return 1
  [[ "$t" == /nix/store/* ]] || return 1
  t="${GOINFRE}/nix/store/$(cut -d/ -f4 <<<"$t")"
  [[ -e "$t" || -L "$t" ]]
}

# MiB this run adds to goinfre. Asks Nix for the exact download when it can;
# otherwise assumes a full build so a big download never starts on a full disk.
need_mib() {
  have_nix || { echo "$FRESH_NEED_MIB"; return; }
  local out
  if ! out="$("${GOINFRE}/bin/nix-user-chroot" "${GOINFRE}/nix" env NIX_USER_CONF_FILES="$HOME/dotfiles-terminal/homes/elel-yak/bootstrap/nix.conf" bash -lc '
    . "$HOME/.nix-profile/etc/profile.d/nix.sh" 2>/dev/null || true
    export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
    for d in /nix/store/*-nix-2.*/bin; do command -v nix >/dev/null && break; [[ -x $d/nix ]] && PATH="$d:$PATH"; done
    cd "$HOME/dotfiles-terminal" && nix build --dry-run .#homeConfigurations.elel-yak.activationPackage
  ' 2>&1)"; then
    echo "goinfre-heal: Nix could not report the download size; assuming a full build" >&2
    echo "$FRESH_NEED_MIB"
    return
  fi
  grep -oE '[0-9.]+ [KMGT]iB unpacked' <<<"$out" | awk -v h="$HEADROOM_MIB" '
    { m = $1; if ($2 == "KiB") m /= 1024; else if ($2 == "GiB") m *= 1024; else if ($2 == "TiB") m *= 1048576; s += m }
    END { printf "%d\n", s + h }'
}

ready=0
reason=""
if ! have_nix; then
  reason="goinfre has no Nix (fresh machine or wiped)"
elif ! in_store "$HOME/.nix-profile" || ! in_store "$HOME/.profile"; then
  reason="your profile points at packages this machine does not have"
elif [[ ! -f "$STAMP" ]]; then
  reason="the last nix-setup did not finish"
else
  ready=1
fi

free="$(free_mib)"
if [[ "$ready" -eq 1 ]]; then
  echo "goinfre-heal: ${host} is ready ($(gib "$free") free on /goinfre)"
  [[ "$mode" == --force ]] || exit 0
  reason="re-running setup on request"
else
  echo "goinfre-heal: ${host} needs setup: ${reason} ($(gib "$free") free on /goinfre)"
  [[ "$mode" == --check ]] && exit 1
fi

need="$(need_mib)"
if ((free < need)); then
  msg="Only $(gib "$free") free on /goinfre; setup needs about $(gib "$need"). Nothing was built."
  echo "goinfre-heal: ${msg}" >&2
  echo "Biggest folders in ${GOINFRE}:" >&2
  timeout 30 du -sh "$GOINFRE"/* 2>/dev/null | sort -h | tail -5 >&2
  notify "Not enough space on ${host}" "${msg} Free space (clean = Nix garbage collection), then run: nix-up"
  exit 2
fi
echo "goinfre-heal: about $(gib "$need") needed, $(gib "$free") free. Starting."

# Gate launchers until the rebuild finishes. A forced re-run on a ready
# machine keeps the stamp: the previous generation still works.
[[ "$ready" -eq 1 ]] || rm -f "$STAMP"
mkdir -p "$GOINFRE"
notify "Setting up ${host}" "${reason^}. Fresh machines take about 10 min. Log: ${LOG}"
start=$SECONDS
if "${here}/nix-setup" 2>&1 | tee "$LOG"; then
  notify "${host} is ready" "Setup finished in $(((SECONDS - start) / 60)) min. kitty, cursor and agent work."
else
  notify "Setup failed on ${host}" "See ${LOG}, then run: nix-up"
  exit 1
fi
