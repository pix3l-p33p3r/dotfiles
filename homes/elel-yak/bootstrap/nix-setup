#!/usr/bin/env bash
# Bootstrap this machine's goinfre: hash-verified nix-user-chroot and Nix, then
# one `home-manager switch`. Every app, launcher and config file is declared in
# Home Manager; this script only gets Nix onto a machine that lacks it.
set -euo pipefail

GOINFRE="${GOINFRE:-/goinfre/$USER}"
CHROOT_BIN="${GOINFRE}/bin/nix-user-chroot"
NIXROOT="${GOINFRE}/nix"
FLAKE="${HOME}/dotfiles-terminal"
# The bootstrap Nix reads the same nix.conf Home Manager installs later.
NIX_CONF="${FLAKE}/homes/elel-yak/bootstrap/nix.conf"

CHROOT_URL="https://github.com/nix-community/nix-user-chroot/releases/download/2.1.1/nix-user-chroot-bin-2.1.1-x86_64-unknown-linux-musl"
CHROOT_SHA256="e6daa6a036e00b939531e5c11e6dcd891140813a09964fd12a64112de500fc15"
NIX_VERSION="2.36.0"
NIX_INSTALL_SHA256="8388dfd4d3c3a0c2dc79f764d453eafcc244255f47c93c1958f4775af22f0353"

log() { printf '==> %s\n' "$*"; }

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/nix-setup.lock"
if ! flock -n 9; then
  log "Another nix-setup is running on this machine; waiting for it"
  flock 9
fi

fetch_verified() { # <url> <sha256> <dest>
  curl -fL --retry 3 -o "$3.part" "$1"
  if ! echo "$2  $3.part" | sha256sum -c --quiet -; then
    rm -f "$3.part"
    log "ERROR: checksum mismatch for $1"
    exit 1
  fi
  mv -f "$3.part" "$3"
}

mkdir -p "${GOINFRE}"/{bin,nix,cache,npm}
chmod 0755 "${NIXROOT}" 2>/dev/null || true

# 1) nix-user-chroot
if [[ ! -x "$CHROOT_BIN" ]]; then
  log "Downloading nix-user-chroot 2.1.1"
  fetch_verified "$CHROOT_URL" "$CHROOT_SHA256" "$CHROOT_BIN"
  chmod +x "$CHROOT_BIN"
fi

# 2) Nix
if [[ ! -d "${NIXROOT}/store" ]]; then
  log "Installing Nix ${NIX_VERSION} into ${NIXROOT}"
  fetch_verified "https://releases.nixos.org/nix/nix-${NIX_VERSION}/install" "$NIX_INSTALL_SHA256" "${GOINFRE}/nix-install"
  "$CHROOT_BIN" "$NIXROOT" sh "${GOINFRE}/nix-install" --no-daemon --no-modify-profile
  rm -f "${GOINFRE}/nix-install"
fi

# 3) The whole user environment
log "Home Manager switch → ${FLAKE}#elel-yak"
hm_ok=0
if "$CHROOT_BIN" "$NIXROOT" bash -lc "
  export NIX_USER_CONF_FILES='${NIX_CONF}'
  . \"\$HOME/.nix-profile/etc/profile.d/nix.sh\" 2>/dev/null || true
  export PATH=\"\$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:\$PATH\"
  # ~/.nix-profile roams and may name another machine's generation; any store nix works.
  for d in /nix/store/*-nix-2.*/bin; do command -v nix >/dev/null && break; [[ -x \$d/nix ]] && PATH=\"\$d:\$PATH\"; done
  cd '${FLAKE}' && nix run .#hm -- switch --flake .#elel-yak -b hm-backup
"; then
  hm_ok=1
else
  log "WARN: home-manager switch failed"
fi

# 4) Host layout: big caches live on goinfre, not the 4.7G home
link_cache() {
  local home_path="$1" go_path="$2"
  mkdir -p "$go_path"
  [[ -L "$home_path" ]] && return 0
  if [[ -d "$home_path" ]]; then
    rsync -a "$home_path"/ "$go_path"/ 2>/dev/null || true
    rm -rf "$home_path"
  fi
  ln -sfn "$go_path" "$home_path"
}
link_cache "${HOME}/.cache" "${GOINFRE}/cache"
link_cache "${HOME}/.npm" "${GOINFRE}/npm"

# Launchers and goinfre-heal treat this stamp as "this machine is ready".
# On failure leave it alone: a ready machine keeps its previous generation.
if [[ "$hm_ok" -ne 1 ]]; then
  log "ERROR: Home Manager did not switch; setup is incomplete"
  exit 1
fi
touch "${GOINFRE}/.setup-ok"
log "Done on $(hostname -s). Goinfre: ${GOINFRE}"
